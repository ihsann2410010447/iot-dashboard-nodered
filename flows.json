    {
        "id": "fth",
        "type": "function",
        "z": "tab1",
        "name": "Threshold",
        "func": "const H = {\"Access-Control-Allow-Origin\":\"*\",\"Access-Control-Allow-Headers\":\"Content-Type, X-API-Key\",\"Access-Control-Allow-Methods\":\"GET, POST, PUT, OPTIONS\"};\nconst KEY = env.get(\"API_KEY\") || \"iot-secret-123\";\nmsg.headers = H;\nconst authed = msg.req.headers[\"x-api-key\"] === KEY;\nif (!authed) { msg.statusCode = 401; msg.payload = {status:\"error\", message:\"Unauthorized: header X-API-Key salah atau tidak ada\"}; }\nif (!authed) return [msg, null];\nlet th = global.get(\"threshold\"); if (th === undefined || th === null) th = 30;\nif (msg.req.method === \"PUT\") {\n  const raw = msg.payload ? msg.payload.threshold : undefined;\n  const v = Number(raw);\n  if (raw === undefined || raw === null || raw === \"\" || !Number.isFinite(v)) {\n    msg.statusCode = 400;\n    msg.payload = {status:\"error\", message:\"threshold harus berupa angka\"};\n    return [msg, null];\n  }\n  global.set(\"threshold\", v);\n  flow.set(\"lastAlert\", 0);\n  msg.statusCode = 200;\n  msg.payload = {status:\"success\", data:{threshold:v}};\n  return [msg, {payload:{type:\"threshold\", threshold:v}}];\n}\nmsg.statusCode = 200;\nmsg.payload = {status:\"success\", data:{threshold:th}};\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
