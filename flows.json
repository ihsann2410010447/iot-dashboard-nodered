    {
        "id": "fsimpan",
        "type": "function",
        "z": "tab1",
        "name": "Simpan Data Sensor",
        "func": "const d = msg.payload;\nconst rec = {suhu:Number(d.suhu), kelembaban:Number(d.kelembaban), received:new Date().toISOString()};\nflow.set(\"latest\", rec);\nlet th = global.get(\"threshold\"); if (th === undefined || th === null) th = 30;\n\nconst toDb = {params:{$suhu:rec.suhu, $hum:rec.kelembaban, $received:rec.received}};\nconst toWs = {payload:{type:\"sensor\", suhu:rec.suhu, kelembaban:rec.kelembaban, received:rec.received, threshold:th}};\nlet alert = null;\nif (rec.suhu > th && Date.now() - (flow.get(\"lastAlert\")||0) > 30000) {   // cooldown 30 dtk\n  flow.set(\"lastAlert\", Date.now());\n  alert = {payload:{type:\"alert\", message:`Suhu ${rec.suhu}°C melewati batas ${th}°C`, suhu:rec.suhu, threshold:th, received:rec.received}};\n}\nreturn [toDb, toWs, alert];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 120,
        "wires": [
            [
                "dbins"
            ],
            [
                "wsout",
                "dbg"
            ],
            [
                "wsout",
                "mqalert",
                "dbgalert"
            ]
        ]
    },
