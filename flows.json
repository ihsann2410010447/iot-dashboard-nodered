        "id": "fsuhu",
        "type": "function",
        "z": "tab1",
        "name": "Build Response Suhu",
        "func": "const H = {\"Access-Control-Allow-Origin\":\"*\",\"Access-Control-Allow-Headers\":\"Content-Type, X-API-Key\",\"Access-Control-Allow-Methods\":\"GET, POST, PUT, OPTIONS\"};\nconst KEY = env.get(\"API_KEY\") || \"iot-secret-123\";\nmsg.headers = H;\nconst authed = msg.req.headers[\"x-api-key\"] === KEY;\nif (!authed) { msg.statusCode = 401; msg.payload = {status:\"error\", message:\"Unauthorized: header X-API-Key salah atau tidak ada\"}; }\nif (!authed) return msg;\nconst l = flow.get(\"latest\");\nmsg.statusCode = 200;\nmsg.payload = {status:\"success\", data: l ? {suhu:l.suhu, kelembaban:l.kelembaban, received:l.received} : {suhu:null, kelembaban:null}};\nreturn msg;",
        "outputs": 1,
