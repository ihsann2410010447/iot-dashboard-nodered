    {
        "id": "proc_kontrol",
        "type": "function",
        "z": "flow_api",
        "name": "Validasi & Publish",
        "func": "var body = msg.payload;\n\n// Validasi input\nif (!body || !body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return [msg, null];\n}\n\n// Output 2: publish ke MQTT\nvar mqttMsg = {payload: body, topic: 'iot/kontrol'};\n\n// Output 1: respon HTTP\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    message: 'Perintah terkirim',\n    sent: body\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn [msg, mqttMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 380,
        "wires": [
