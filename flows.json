    {
        "id": "fkon",
        "type": "function",
        "z": "tab1",
        "name": "Validasi & Publish",
        "func": "const H = {\"Access-Control-Allow-Origin\":\"*\",\"Access-Control-Allow-Headers\":\"Content-Type, X-API-Key\",\"Access-Control-Allow-Methods\":\"GET, POST, PUT, OPTIONS\"};\nconst KEY = env.get(\"API_KEY\") || \"iot-secret-123\";\nmsg.headers = H;\nconst authed = msg.req.headers[\"x-api-key\"] === KEY;\nif (!authed) { msg.statusCode = 401; msg.payload = {status:\"error\", message:\"Unauthorized: header X-API-Key salah atau tidak ada\"}; }\nif (!authed) return [msg, null];\nconst b = msg.payload || {};\nif (b.device !== \"lamp\" || ![\"on\",\"off\"].includes(b.action)) {\n  msg.statusCode = 400;\n  msg.payload = {status:\"error\", message:\"device harus 'lamp' dan action 'on'/'off'\"};\n  return [msg, null];\n}\nmsg.statusCode = 200;\nconst out = {payload:{device:b.device, action:b.action}};\nmsg.payload = {status:\"success\", message:`${b.device} -> ${b.action}`};\nreturn [msg, out];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
